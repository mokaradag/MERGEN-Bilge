# ==============================================================================
# .Renviron.example - MERGEN Bilge ortam değişkeni ŞABLONU
# ------------------------------------------------------------------------------
# Bu dosya bir ŞABLONDUR ve yalnızca yer tutucu (placeholder) değerler içerir.
# Kullanım:
#   1) Bu dosyayı `.Renviron` olarak kopyalayın:  cp .Renviron.example .Renviron
#   2) Gerçek değerleri `.Renviron` içine yazın.
#   3) `.Renviron` `.gitignore` ile izlenmez; ASLA sürüm kontrolüne eklemeyin.
#
# GÜVENLİK: Gerçek sırlar (DB DSN, AI_KEYS_MASTER, varsayılan API anahtarı,
# token'lar) yalnızca dağıtım sunucusundaki `.Renviron` içinde bulunmalıdır.
# Bu örnek dosya GitHub'a girer; gerçek `.Renviron` girmez.
# ==============================================================================

DB_CLIENT_ENCODING=WINDOWS-1254
DB_NAME_ENCODING=WINDOWS-1254

# ------------------------------------------------------------------------------
# VERİTABANI BAĞLANTILARI (MULTI-DB SETUP)
# ------------------------------------------------------------------------------
DB_SERVER="your_server_address"
DB_DSN="MainConnection"
DB_DSN_2="SecondaryConnection_Placeholder"
DB_DSN_3="TertiaryConnection_Placeholder"

# ------------------------------------------------------------------------------
# SSO (TEK OTURUM AÇMA) AYARLARI
# ------------------------------------------------------------------------------
# Küresel mod anahtarı: TRUE = Keycloak SSO aktif, FALSE = yerel geliştirme modu
SSO_ENABLED=FALSE

# Keycloak sunucu adresi (örnek: https://keycloak.example.com)
SSO_KEYCLOAK_URL=

# Keycloak realm adı
SSO_REALM=byd_intranet_apps

# Keycloak istemci (client) kimliği
SSO_CLIENT_ID=mergen

# Token doğrulama seçenekleri
SSO_VALIDATE_ISSUER=TRUE
SSO_VALIDATE_EXPIRY=TRUE

# JWT imza (signature) doğrulaması. Varsayılan TRUE (güvenli varsayılan):
# token'ın Keycloak tarafından imzalandığı JWKS genel anahtarı ile kriptografik
# olarak doğrulanır. JWKS uygulama sunucusundan erişilemiyorsa geçici olarak
# FALSE yapılabilir; ancak üretimde TRUE önerilir.
SSO_VALIDATE_SIGNATURE=TRUE

# JWKS uç noktası override'ı (boşsa issuer'dan otomatik türetilir:
# {issuer}/protocol/openid-connect/certs)
SSO_JWKS_URL=

# JWKS genel anahtar önbellek ömrü (saniye)
SSO_JWKS_CACHE_TTL=3600

# Token yenileme uyarı süresi (saniye)
SSO_TOKEN_REFRESH_MARGIN=300

# SSO hata ayıklama modu (detaylı log çıktısı)
SSO_DEBUG=FALSE

# Çıkış (Logout) URL'si. Boşsa SSO modunda Keycloak logout_endpoint kullanılır.
MERGEN_LOGOUT_URL=

# ------------------------------------------------------------------------------
# DİĞER AYARLAR
# ------------------------------------------------------------------------------

# Kullanıcı API anahtarlarını şifrelemek için 32+ karakterlik rastgele sır.
# ÜRETİMDE mutlaka uzun, rastgele ve gizli bir değerle değiştirin.
AI_KEYS_MASTER="change_this_to_a_long_random_secret_string"

LOCAL_LLM_ENDPOINT=https://your-actual-api-endpoint.com/v1/chat/completions
LOCAL_LLM_ENDPOINT_ALT=https://your-secondary-endpoint.com/v1/chat/completions
LOCAL_LLM_ENDPOINT_ALT_API_KEY=secondary-endpoint-api-key

# Varsayılan kurum API anahtarı. GitHub'a yazılmaz, loglanmaz, kullanıcıya gösterilmez.
MERGEN_ALLOW_DEFAULT_API_KEY=TRUE
MERGEN_REQUIRE_PERSONAL_API_KEY=FALSE
MERGEN_DEFAULT_API_KEY=paste-the-default-company-api-key-here

# MCP dosya yüklemeleri için kalıcı temel klasör (UNC veya yerel yol)
MCP_FILES_BASE=//mainserver/share/mergen_uploads

# MERGEN dosya deposu sağlık kontrolleri
MERGEN_FILES_ROOT="//mainserver/MERGEN Bilge/data"
MERGEN_UPLOADS_DIR="//mainserver/MERGEN Bilge/mergen_uploads"
MERGEN_INDEX_PATH="//mainserver/MERGEN Bilge/data/index.json"
MERGEN_MCP_BASE_DIR="//mainserver/MERGEN Bilge/mergen_uploads"
MERGEN_LOG_DIR="//mainserver/MERGEN Bilge/logs"

SERVICE_DESK_API_KEY_URL=https://<your-servicedesk>/api-key
SERVICE_DESK_RATE_LIMIT_URL=https://<your-servicedesk>/rate-limit

# Yerel metin-konuşma (TTS) ayarları
LOCAL_TTS_ENDPOINT=https://your-tts-endpoint/v1
LOCAL_TTS_MODEL=tts-1-hd
LOCAL_TTS_VOICE=tr-male-1
LOCAL_TTS_VERIFY_SSL=TRUE
LOCAL_TTS_TIMEOUT=90

LOCAL_STT_ENDPOINT=http://localhost:8080/v1/audio/transcriptions
LOCAL_STT_MODEL=whisper-large-v3

# İsteğe bağlı: TTS/STT API anahtarı override (boşsa ana şifreli anahtar kullanılır)
LOCAL_TTS_API_KEY=
LOCAL_STT_API_KEY=

# Filtreleme için kullanılacak model
FILTER_MODEL=technical name 1

# Görsel anlama destekli modeller (Image Input)
# Model kimliklerini yalnızca ";" veya "," ile ayırın.
MERGEN_VISION_MODELS=your-vision-model-id-1;your-vision-model-id-2

# ------------------------------------------------------------------------------
# GÖRSEL OLUŞTURMA AYARLARI (IMAGE GENERATION)
# ------------------------------------------------------------------------------
IMAGE_GEN_ENDPOINT=https://your-image-api-endpoint.com/v1/images/generations
IMAGE_GEN_MODEL=dall-e-3
TRANSLATION_MODEL=technical name 1
IMAGE_GEN_TIMEOUT=180

# ------------------------------------------------------------------------------
# AI UZMAN (AI EXPERT) KONUŞMA AYARLARI
# ------------------------------------------------------------------------------
AI_EXPERT_MODEL=technical name 1

# ------------------------------------------------------------------------------
# DESTEK CHATBOT AYARLARI
# ------------------------------------------------------------------------------
DESTEK_CHATBOT_MODEL=technical name 1

# ------------------------------------------------------------------------------
# Claude Code (Bilge Yolaç) yapılandırması
# ------------------------------------------------------------------------------
CLAUDE_CODE_CLI_PATH=C:/Users/<user>/AppData/Roaming/npm/claude.cmd
CLAUDE_CODE_NODE_PATH=C:/Program Files/nodejs/node.exe
CLAUDE_CODE_DEFAULT_WORKDIR=C:/Temp/mergen_claude

CLAUDE_CODE_THINKING_MODELS=model-a,model-b
CLAUDE_CODE_BINARY_DOC_EXTENSIONS=pdf,xlsx,xls,doc,docx,ppt,pptx
CLAUDE_CODE_AUTO_FALLBACK_NON_THINKING_FOR_BINARY_DOCS=TRUE

CLAUDE_CODE_ALLOW_DANGEROUS_PERMISSIONS=FALSE
CLAUDE_CODE_ALLOW_USER_SELECTED_WORKDIRS=TRUE
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
CLAUDE_CODE_ALLOWED_TOOLS=Read;Write;Edit;MultiEdit;Glob;Grep;LS;Bash
CLAUDE_CODE_DISALLOWED_TOOLS=

# ------------------------------------------------------------------------------
# Araç Modelleri Yapılandırması
# ------------------------------------------------------------------------------
EXCEL_DEEP_LOW_MODEL=<technical model name 1>
EXCEL_DEEP_HIGH_MODEL=<technical model name 2>
CODING_DEEP_LOW_MODEL=<technical model name 1>
CODING_DEEP_HIGH_MODEL=<technical model name 2>