# ==============================================================================
# .Renviron.example - MERGEN Bilge ortam değişkeni ŞABLONU
# ------------------------------------------------------------------------------
# Bu dosya bir ŞABLONDUR ve yalnızca yer tutucu (placeholder) değerler içerir.
# Kullanım:
#   1) Bu dosyayı `.Renviron` olarak kopyalayın:  cp .Renviron.example .Renviron
#   2) Gerçek değerleri `.Renviron` içine yazın.
#   3) `.Renviron` `.gitignore` ile izlenmez; ASLA sürüm kontrolüne eklemeyin.
#
# GÜVENLİK: Gerçek sırlar (DB DSN, AI_KEYS_MASTER, varsayılan API anahtarı,
# token'lar) yalnızca dağıtım sunucusundaki `.Renviron` içinde bulunmalıdır.
# Bu örnek dosya GitHub'a girer; gerçek `.Renviron` girmez.
# ==============================================================================

DB_CLIENT_ENCODING=WINDOWS-1254
DB_NAME_ENCODING=WINDOWS-1254

# ------------------------------------------------------------------------------
# VERİTABANI BAĞLANTILARI (MULTI-DB SETUP)
# ------------------------------------------------------------------------------
DB_SERVER="your_server_address"
DB_DSN="MainConnection"
DB_DSN_2="SecondaryConnection_Placeholder"
DB_DSN_3="TertiaryConnection_Placeholder"

# İşlem-güvenli DB bağlantı havuzu (opsiyonel). Varsayılan KAPALI: her çağrı
# doğrudan ODBC bağlantısı açar. TRUE yapıldığında okuma yolları havuzlanır ve
# çok-ifadeli işlemler (save_message_to_db) güvenli checkout kullanır. Üretimde
# açmadan önce SQL Server Türkçe at-rest doğrulamasını yapın (bkz.
# docs/database-pooling.md). Encoding sözleşmesi havuzda da korunur.
MERGEN_DB_POOL_ENABLED=TRUE
MERGEN_DB_POOL_MIN_SIZE=1
MERGEN_DB_POOL_MAX_SIZE=8
MERGEN_DB_POOL_IDLE_TIMEOUT=600
MERGEN_DB_POOL_FAIL_FAST=FALSE
MERGEN_DB_POOL_WRITE_TEST=FALSE

# NOT: Havuz, bağlantıları yalnızca CHECKOUT anında (SELECT 1) doğrular. pool'un
# `later` üzerindeki TEKRARLAYAN arka plan doğrulaması bilerek KAPALIDIR
# (validationInterval=0): geçici SQL Server kopmasında o görevdeki yakalanmamış
# dbConnect hatası tüm uygulamayı çökertiyordu. Bu değer artık yalnızca
# geriye dönük uyumluluk/raporlama içindir; havuz davranışını DEĞİŞTİRMEZ.
# (bkz. docs/database-pooling.md 4.1).
MERGEN_DB_POOL_VALIDATION_INTERVAL=60

# ------------------------------------------------------------------------------
# SSO (TEK OTURUM AÇMA) AYARLARI
# ------------------------------------------------------------------------------
# Küresel mod anahtarı: TRUE = Keycloak SSO aktif, FALSE = yerel geliştirme modu
SSO_ENABLED=FALSE

# Keycloak sunucu adresi (örnek: https://keycloak.example.com)
SSO_KEYCLOAK_URL=

# Keycloak realm adı
SSO_REALM=byd_intranet_apps

# Keycloak istemci (client) kimliği
SSO_CLIENT_ID=mergen

# Token doğrulama seçenekleri
SSO_VALIDATE_ISSUER=TRUE
SSO_VALIDATE_EXPIRY=TRUE

# JWT imza (signature) doğrulaması. Varsayılan TRUE (güvenli varsayılan):
# token'ın Keycloak tarafından imzalandığı JWKS genel anahtarı ile kriptografik
# olarak doğrulanır. JWKS uygulama sunucusundan erişilemiyorsa geçici olarak
# FALSE yapılabilir; ancak üretimde TRUE önerilir.
SSO_VALIDATE_SIGNATURE=TRUE

# JWKS uç noktası override'ı (boşsa issuer'dan otomatik türetilir:
# {issuer}/protocol/openid-connect/certs)
SSO_JWKS_URL=

# JWKS genel anahtar önbellek ömrü (saniye)
SSO_JWKS_CACHE_TTL=3600

# Token yenileme uyarı süresi (saniye)
SSO_TOKEN_REFRESH_MARGIN=300

# SSO hata ayıklama modu (detaylı log çıktısı)
SSO_DEBUG=FALSE

# Çıkış (Logout) URL'si. Boşsa SSO modunda Keycloak logout_endpoint kullanılır.
MERGEN_LOGOUT_URL=

# ------------------------------------------------------------------------------
# DİĞER AYARLAR
# ------------------------------------------------------------------------------

# Kullanıcı API anahtarlarını şifrelemek için 32+ karakterlik rastgele sır.
# ÜRETİMDE mutlaka uzun, rastgele ve gizli bir değerle değiştirin.
AI_KEYS_MASTER="change_this_to_a_long_random_secret_string"

# Tek birincil yerel LLM uç noktası. (Eski ikincil LLM uç noktası kavramı
# kaldırılmıştır; eskiden ayrı uca giden akışlar artık Langflow ile karşılanır.)
LOCAL_LLM_ENDPOINT=https://your-actual-api-endpoint.com/v1/chat/completions

# ------------------------------------------------------------------------------
# KURUMSAL LANGFLOW AKIŞ ENTEGRASYONU
# ------------------------------------------------------------------------------
# "Süreç Yönetimi" ve "Uygulama Uzmanı" araçları, normal yerel LLM uç noktası
# yerine kurumsal Langflow akışlarını (Chat Input / Chat Output) çağırır. Model,
# Langflow akışının içine gömülüdür; bu araçların yerel bir modeli yoktur.
# Mergen, akışı şu uç noktaya POST eder:
#   {LANGFLOW_BASE_URL}/{flow_id}
# Gövde: {"input_value": "...", "output_type": "chat", "input_type": "chat",
#         "session_id": "mergen_<kullanici>_<sohbet>"}
# Başlık: Content-Type: application/json, x-api-key: {LANGFLOW_API_KEY}
#
# LANGFLOW_API_KEY Langflow'a özgüdür ve yerel LLM anahtarlarıyla ilişkisi
# yoktur; örtük geriye dönük fallback YOKTUR. Bu değişkenler tanımsız bırakılırsa
# ilgili araç net bir "yapılandırma eksik" mesajı gösterir (normal LLM'ye düşmez).
#
# Taban URL Langflow akış çalıştırma yolunu (/api/v1/run) içermelidir; Mergen
# sonuna yalnızca "/{flow_id}" ekler. Sondaki '/' otomatik temizlenir.
LANGFLOW_BASE_URL=https://your-langflow-server.example.com/api/v1/run
# Langflow API anahtarı (x-api-key).
LANGFLOW_API_KEY=your-langflow-api-key

# Süreç Yönetimi ÇOKLU akış desteği: kullanıcı sohbet giriş alanındaki açılır
# menüden hangi süreç akışını kullanacağını seçer. Kimlikler ve görünen adlar
# ";" (veya ",") ile ayrılır; sıralar birebir eşleşmelidir. Ad eksikse "Akış 1",
# "Akış 2" gibi güvenli yedek adlar kullanılır. Yeni akışlar listeye eklenebilir.
#
# ÖNEMLİ: .Renviron içinde yorumlar AYRI SATIRA yazılmalıdır. readRenviron()
# satır içi yorumu değerin parçası sayar; kimlik listesindeki ilk "#" ve sonrası
# savunma amaçlı ayıklansa da değer satırına yorum eklemeyin. Ayıklama sonrası
# hâlâ bozuk (boşluk/URL-dışı karakter içeren) bir kimlik kalırsa TÜM akış
# listesi net bir yapılandırma hatasıyla reddedilir; seçilen akış asla sessizce
# 1. akışa yönlendirilmez.
LANGFLOW_PROCESS_FLOW_IDS=process-flow-id-1;process-flow-id-2
LANGFLOW_PROCESS_FLOW_NAMES=Süreç Akışı 1;Süreç Akışı 2
# Uygulama Uzmanı tek akış kullanır.
LANGFLOW_APP_EXPERT_FLOW_ID=app-expert-flow-id-here
# Langflow yanıt zaman aşımı (saniye). Tanımsız/geçersizse 300 sn kullanılır.
LANGFLOW_TIMEOUT_SECONDS=300

# Varsayılan kurum API anahtarı. GitHub'a yazılmaz, loglanmaz, kullanıcıya gösterilmez.
MERGEN_ALLOW_DEFAULT_API_KEY=TRUE
MERGEN_REQUIRE_PERSONAL_API_KEY=FALSE
MERGEN_DEFAULT_API_KEY=paste-the-default-company-api-key-here

# MCP dosya yüklemeleri için kalıcı temel klasör (UNC veya yerel yol)
MCP_FILES_BASE=//mainserver/share/mergen_uploads

# MERGEN dosya deposu sağlık kontrolleri
MERGEN_FILES_ROOT="//mainserver/MERGEN Bilge/data"
MERGEN_UPLOADS_DIR="//mainserver/MERGEN Bilge/mergen_uploads"
MERGEN_INDEX_PATH="//mainserver/MERGEN Bilge/data/index.json"
MERGEN_MCP_BASE_DIR="//mainserver/MERGEN Bilge/mergen_uploads"

# Günlük log dizini. Uygulama, günlük dosyasını (mergen_YYYYMMDD.log) BU dizine
# yazar. ÖNEMLİ: Üretim başlatıcısı (run_mergen_prod.bat) bugünün mergen_*.log
# dosyasını UYGULAMA KLASÖRÜNÜN yerel "logs\" dizininde ön-oluşturur ve canlı
# izleyici (view_latest_mergen_app_log.bat) AYNI yerel "logs\" dizinini izler.
# Bu yüzden canlı izleyicinin/operatörün baktığı yerde günlük logun dolması için
# MERGEN_LOG_DIR'in uygulama klasörünün KENDİ "logs" dizinine çözülmesi GEREKİR.
# Önerilen (yerel, sıfır risk): bu satırı uygulama klasörünün "logs" dizinine
# ayarlayın ya da satırı kaldırın (kaldırılırsa uygulama varsayılan olarak
# çalışma dizini\logs = uygulama klasörü\logs kullanır).
#   Örnek: MERGEN_LOG_DIR="//mainserver/MERGEN Bilge/logs"  (uygulama klasörünüzün logs dizini)
# Eğer MERGEN_LOG_DIR'i farklı/merkezî bir paylaşıma yönlendirirseniz, uygulama
# loglarını oraya yazmaya devam eder; ancak BAT'in ön-oluşturduğu yerel dosya ve
# canlı izleyici BOŞ görünür. Bu durumda günlük logu yapılandırdığınız
# MERGEN_LOG_DIR yolunda arayın (Sistem Durumu > "Günlük Log Sağlığı" kartı
# incelenen dosya yolunu gösterir).
MERGEN_LOG_DIR="//mainserver/MERGEN Bilge/logs"

SERVICE_DESK_API_KEY_URL=https://<your-servicedesk>/api-key
SERVICE_DESK_RATE_LIMIT_URL=https://<your-servicedesk>/rate-limit

# Yerel metin-konuşma (TTS) ayarları
LOCAL_TTS_ENDPOINT=https://your-tts-endpoint/v1
LOCAL_TTS_MODEL=tts-1-hd
LOCAL_TTS_VOICE=tr-male-1
LOCAL_TTS_VERIFY_SSL=TRUE
LOCAL_TTS_TIMEOUT=90

LOCAL_STT_ENDPOINT=http://localhost:8080/v1/audio/transcriptions
LOCAL_STT_MODEL=whisper-large-v3

# İsteğe bağlı: TTS/STT API anahtarı override (boşsa ana şifreli anahtar kullanılır)
LOCAL_TTS_API_KEY=
LOCAL_STT_API_KEY=

# Filtreleme için kullanılacak model
FILTER_MODEL=technical name 1

# Görsel anlama destekli modeller (Image Input)
# Model kimliklerini yalnızca ";" veya "," ile ayırın.
MERGEN_VISION_MODELS=your-vision-model-id-1;your-vision-model-id-2

# ------------------------------------------------------------------------------
# GÖRSEL OLUŞTURMA AYARLARI (IMAGE GENERATION)
# ------------------------------------------------------------------------------
IMAGE_GEN_ENDPOINT=https://your-image-api-endpoint.com/v1/images/generations
IMAGE_GEN_MODEL=dall-e-3
TRANSLATION_MODEL=technical name 1
IMAGE_GEN_TIMEOUT=180

# ------------------------------------------------------------------------------
# AI UZMAN (AI EXPERT) KONUŞMA AYARLARI
# ------------------------------------------------------------------------------
AI_EXPERT_MODEL=technical name 1

# ------------------------------------------------------------------------------
# DESTEK CHATBOT AYARLARI
# ------------------------------------------------------------------------------
DESTEK_CHATBOT_MODEL=technical name 1

# ------------------------------------------------------------------------------
# Claude Code (Bilge Yolaç) yapılandırması
# ------------------------------------------------------------------------------
CLAUDE_CODE_CLI_PATH=C:/Users/<user>/AppData/Roaming/npm/claude.cmd
CLAUDE_CODE_NODE_PATH=C:/Program Files/nodejs/node.exe
CLAUDE_CODE_DEFAULT_WORKDIR=C:/Temp/mergen_claude
# Bilge Yolaç ajan çalıştırma zaman aşımı (saniye). 14400 = 4 saat.
CLAUDE_CODE_TIMEOUT=14400

CLAUDE_CODE_THINKING_MODELS=model-a,model-b
CLAUDE_CODE_BINARY_DOC_EXTENSIONS=pdf,xlsx,xls,doc,docx,ppt,pptx
CLAUDE_CODE_AUTO_FALLBACK_NON_THINKING_FOR_BINARY_DOCS=TRUE

CLAUDE_CODE_ALLOW_DANGEROUS_PERMISSIONS=FALSE
CLAUDE_CODE_ALLOW_USER_SELECTED_WORKDIRS=TRUE
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
CLAUDE_CODE_ALLOWED_TOOLS=Read;Write;Edit;MultiEdit;Glob;Grep;LS;Bash
CLAUDE_CODE_DISALLOWED_TOOLS=

# ------------------------------------------------------------------------------
# Araç Modelleri Yapılandırması
# ------------------------------------------------------------------------------
EXCEL_DEEP_LOW_MODEL=<technical model name 1>
EXCEL_DEEP_HIGH_MODEL=<technical model name 2>
CODING_DEEP_LOW_MODEL=<technical model name 1>
CODING_DEEP_HIGH_MODEL=<technical model name 2>
# ------------------------------------------------------------------------------
# Operasyonel Soak / Yük Kapısı (opsiyonel; tests/scripts/run_operational_soak_gate.R)
# ------------------------------------------------------------------------------
# Bu değişkenler yalnızca operasyonel soak/yük testini çalıştırırken gereklidir;
# normal uygulama çalışması için ZORUNLU DEĞİLDİR. Ayrıntılar:
# docs/operational-soak-gate.md
#
# Profil ve yoğunluk (profil varsayılanlarını override eder):
#   MERGEN_SOAK_PROFILE=smoke         # smoke|pilot|org|stress|fake_llm|proxy_llm|real_llm
#   MERGEN_SOAK_LLM_MODE=fake         # fake|proxy|real-canary
#   MERGEN_SOAK_CONCURRENT_USERS=10
#   MERGEN_SOAK_DURATION_MINUTES=30
#   MERGEN_SOAK_DURATION_SECONDS=30       # short smoke override; minutes değerini geçersiz kılar
#   MERGEN_SOAK_CAPACITY_CURVE=FALSE      # temiz tek-yük koşumları için
#   MERGEN_SOAK_APP_URL=http://127.0.0.1:8009/  # Windows VM production launcher attach portu
#   MERGEN_SOAK_USER_BASE_TARGET=1000
#
# Kademeli kapasite merdiveni (staged ladder): dogrudan 1000'e atlamadan
# 50->100->250->500->1000 adimlarla son STABIL kapasiteyi olcer. Ilk basarisiz
# adimda durur ve son stabil adimi durustce raporlar.
#   MERGEN_SOAK_CAPACITY_LADDER=FALSE             # TRUE -> kademeli merdiven modu
#   MERGEN_SOAK_CAPACITY_USERS=50,100,150,250,500,750,1000  # merdiven adimlari (bossa varsayilan)
#   MERGEN_SOAK_CAPACITY_STEP_SECONDS=600         # adim basina sure (merdiven varsayilani 600)
#   MERGEN_SOAK_STOP_ON_FIRST_FAILED_STEP=TRUE    # ilk basarisiz adimda dur
#   MERGEN_SOAK_STABLE_SUCCESS_RATE_MIN=0.98      # bir adimin "stabil" sayilmasi icin esik
#
# Sistem telemetrisi (CPU/bellek/TCP ornekleme; darbogaz atfi icin). Varsayilan
# ACIK; OS sayaclari okunamazsa soak'u KIRMAZ (UNMEASURED raporlanir).
#   MERGEN_SOAK_TELEMETRY_ENABLED=TRUE
#   MERGEN_SOAK_TELEMETRY_INTERVAL_SECONDS=5
#
# Opsiyonel KUCUK gercek-LLM throughput probe (uygulama kapasitesi DEGIL;
# fake/proxy ile karistirilmaz). Yalniz real-canary seridinde anlamlidir.
#   MERGEN_REAL_LLM_THROUGHPUT_PROBE=FALSE
#   MERGEN_REAL_LLM_THROUGHPUT_USERS=2
#   MERGEN_REAL_LLM_THROUGHPUT_MAX_USERS=5        # sert tavan (asilmaz)
#   MERGEN_REAL_LLM_THROUGHPUT_DURATION_SECONDS=300
#
# Gercek tarayici/websocket eszamanlilik lane (VM/local; ayri betik:
# tests/scripts/run_browser_concurrency_lane.R). browser_console_errors yalniz
# bu lane CALISTIGINDA olculur.
#   MERGEN_BROWSER_CONCURRENCY_ENABLED=FALSE
#   MERGEN_BROWSER_CONCURRENCY_USERS=10
#   MERGEN_BROWSER_CONCURRENCY_MAX_USERS=50       # uygulama VM'inde 1000 tarayici CALISTIRMAYIN
#   MERGEN_BROWSER_CONCURRENCY_DURATION_SECONDS=300
#   MERGEN_BROWSER_CONCURRENCY_BASE_URL=http://127.0.0.1:8009/
#   MERGEN_BROWSER_CONCURRENCY_HEADLESS=TRUE
#
# Gercek SQL Server havuzlu DB at-rest preflight (VM-only; ayri betik:
# tests/scripts/run_vm_sqlserver_pool_preflight_real.R).
#   MERGEN_SQLSERVER_POOL_PREFLIGHT_REAL=FALSE    # TRUE + MERGEN_DB_POOL_ENABLED=TRUE ile calisir
#   MERGEN_SQLSERVER_POOL_WRITE_TEST=FALSE        # TRUE -> etiketli tablo ile commit/rollback/at-rest
#
# Fake endpoint davranışı (Lane A):
#   MERGEN_SOAK_FAKE_LATENCY_MS_MIN=80
#   MERGEN_SOAK_FAKE_LATENCY_MS_MAX=600
#   MERGEN_SOAK_FAKE_ERROR_RATE=0.02
#   MERGEN_SOAK_FAKE_TIMEOUT_RATE=0.01
#   MERGEN_SOAK_FAKE_STREAM=TRUE
#   MERGEN_SOAK_FAKE_LONG_RESPONSE_RATE=0.05
#
# Proxy serit (Lane B):
#   MERGEN_SOAK_PROXY_FORWARD_REAL=FALSE
#   MERGEN_SOAK_MAX_REAL_LLM_RPM=3
#
# Gerçek endpoint canary (Lane C) - YALNIZCA gerektiğinde ayarlayın:
#   MERGEN_SOAK_REAL_CANARY_USERS=2
#   MERGEN_SOAK_REAL_CANARY_INTERVAL_SECONDS=60
#   MERGEN_SOAK_REAL_ENDPOINT_URL=<gercek-endpoint>/v1/chat/completions
#   MERGEN_SOAK_REAL_MODEL=<gercek-model-adi>
#   MERGEN_SOAK_REAL_API_KEY=<gercek-anahtar>   # tek gerçek anahtar; canary/proxy dışında kullanılmaz
#
#   # Uyumluluk ayarları:
#   MERGEN_SOAK_REAL_STREAM=FALSE
#   MERGEN_SOAK_REAL_MAX_TOKENS=64
#   MERGEN_SOAK_REAL_TEMPERATURE=0.4
#   MERGEN_SOAK_REAL_OMIT_TEMPERATURE=TRUE
#   MERGEN_SOAK_REAL_AUTH_HEADER=Authorization
#   MERGEN_SOAK_REAL_AUTH_SCHEME=Bearer
#
#   # Gateway alternatifleri (gerektiğinde scheme=none ile deneyin; gerçek key yazmayın):
#   MERGEN_SOAK_REAL_AUTH_HEADER=api-key
#   MERGEN_SOAK_REAL_AUTH_HEADER=x-api-key
#   MERGEN_SOAK_REAL_AUTH_HEADER=Ocp-Apim-Subscription-Key
#   MERGEN_SOAK_REAL_AUTH_SCHEME=none
#
#   # Real-canary diagnostik artifact: artifacts/soak/<timestamp>/real_canary_diagnostics.jsonl
#   # response_preview alanı payload/model/auth/gateway hatalarını ayırmak için kullanılır.
#
# Eşikler (ölçülemeyen eşikler sessizce geçmez):
#   MERGEN_SOAK_SUCCESS_RATE_MIN=0.98
#   MERGEN_SOAK_P95_LATENCY_MS_MAX=0            # 0 = raporla, eşik uygulama
#   MERGEN_SOAK_MEMORY_GROWTH_MB_MAX=-1         # <0 = raporla, eşik yok
#   MERGEN_SOAK_TEMP_GROWTH_MB_MAX=-1
#   MERGEN_SOAK_FAIL_ON_MOJIBAKE=TRUE
#   MERGEN_SOAK_FAIL_ON_SECRET_LEAK=TRUE
#
# Attach modu (çalışan uygulamaya HTTP-düzeyi erişilebilirlik):
#   # Üretim launcher portu 8009; eski 28081 değeri üretim app attach için kullanılmamalıdır.
#   MERGEN_SOAK_APP_URL=http://127.0.0.1:8009/
#
# Not: .Renviron değerleri aktif PowerShell $env:MERGEN_SOAK_* değerleri tarafından
# override edilebilir. Kontrollü deneylerde env temizliği sonrası değerleri açıkça set edin.

# ==============================================================================
# AKIŞ (STREAMING) OLAY-DÖNGÜSÜ SERTLEŞTİRME ANAHTARLARI
# ==============================================================================
# Bu anahtarların TAMAMI opsiyoneldir ve VARSAYILANLARI MEVCUT DAVRANIŞI korur
# (no-op). Hepsi Sys.getenv() ile okunur; bu yüzden tanımlanacakları doğru yer
# .Renviron'dur (uygulama yeniden başlatıldığında okunur — tarayıcı yenilemesi
# yetmez). Aşağıdaki satırlar yorumlu (#) bırakılmıştır: yalnızca üretimde davranış
# ayarlamak istediğinizde ilgili satırı açın ve değeri girin.
# Ayrıntılı açıklama: docs/performance-improvement-plan.md ve docs/operational-soak-gate.md.
#
# --- Yoklama (poll) aralığı ve uyarlanır geri çekilme (idle backoff) ---
#   Varsayılan: KAPALI = sabit yoklama aralığı (mevcut davranış). Açıkken, boş
#   yoklamalarda aralık MIN'den MAX'a doğru FACTOR ile büyür; yeni veri gelince
#   MIN'e döner. Çok sayıda eşzamanlı boştaki akışta olay-döngüsü uyanmalarını azaltır.
# MERGEN_STREAM_POLL_IDLE_BACKOFF=false
# MERGEN_STREAM_POLL_MIN_MS=25
# MERGEN_STREAM_POLL_MAX_MS=250
# MERGEN_STREAM_POLL_BACKOFF_FACTOR=1.5
# MERGEN_STREAM_POLL_RESET_ON_DELTA=true
#
# --- Delta taşımacılığı (artımlı güncelleme) ---
#   Varsayılan: profil bazlı (yalnızca hızlı profiller delta kullanır). DELTA_DEFAULT
#   açıkken tüm gerçek-akış istekleri artımlı streamingDelta kullanır. FULL_UPDATE_LEGACY
#   açıkken eski tam-birikmiş güncelleme zorlanır (her ikisi açıksa legacy kazanır).
# MERGEN_STREAM_DELTA_DEFAULT=true
# MERGEN_STREAM_FULL_UPDATE_LEGACY=false
#
# --- Takip (follow-up) önerisi üretimi yük denetimi ---
#   FOLLOWUPS_ENABLED: küresel açma/kapama. FOLLOWUP_DELAY_SECONDS: üretimi ek geciktir.
#   DISABLE_FOLLOWUPS_UNDER_BACKPRESSURE: limit dolunca üretimi atla (kuyruğa alma).
# MERGEN_FOLLOWUPS_ENABLED=true
# MERGEN_FOLLOWUP_DELAY_SECONDS=0
# MERGEN_DISABLE_FOLLOWUPS_UNDER_BACKPRESSURE=true
#
# --- Kaydedilen sohbet (saved chats) yenileme debounce'u ---
#   Varsayılan 0 = anında yenile (mevcut davranış). >0 iken pencere içindeki çoklu
#   yenileme tek zamanlayıcıda birleştirilir (oturum-yerel).
# MERGEN_SAVED_CHATS_REFRESH_DEBOUNCE_MS=0
#
# --- İşlem-bazlı kabul denetimi (backpressure) ---
#   Varsayılan 0 = KAPALI (no-op). >0 iken ilgili araç ailesinde eşzamanlı LLM
#   isteği üst sınırı uygulanır; aşımda kullanıcıya "sunucu yoğun" toast'ı döner
#   (durdur/iptal akışı bozulmaz). TTL eski/sızdırılmış slotları geri toplar.
# MERGEN_MAX_CONCURRENT_LLM=0
# MERGEN_MAX_CONCURRENT_SQL_ANALYSIS=0
# MERGEN_MAX_CONCURRENT_MCP_EXCEL=0
