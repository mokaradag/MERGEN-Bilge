# This file stores secret environment variables for your Shiny app.
# It should be added to your .gitignore file to prevent it from being
# committed to version control.

# ------------------------------------------------------------------------------
# VERİTABANI BAĞLANTILARI (MULTI-DB SETUP)
# ------------------------------------------------------------------------------

DB_SERVER="your_server_address"

# 1. VARSAYILAN (BİRİNCİ) VERİTABANI
DB_DSN="MainConnection"

# 2. İKİNCİ VERİTABANI 
DB_DSN_2="SecondaryConnection_Placeholder"

# 3. ÜÇÜNCÜ VERİTABANI
DB_DSN_3="TertiaryConnection_Placeholder"

# ------------------------------------------------------------------------------
# DİĞER AYARLAR
# ------------------------------------------------------------------------------

# 32+ chars random secret for encrypting user API keys
AI_KEYS_MASTER="change_this_to_a_long_random_secret_string"

LOCAL_LLM_ENDPOINT=https://your-actual-api-endpoint.com/v1/chat/completions
LOCAL_LLM_ENDPOINT_ALT=https://your-secondary-endpoint.com/v1/chat/completions
LOCAL_LLM_ENDPOINT_ALT_API_KEY=secondary-endpoint-api-key

# Persisted base folder for MCP-file uploads (UNC or local path)
MCP_FILES_BASE=//mainserver/share/mergen_uploads

SERVICE_DESK_API_KEY_URL=https://<your-servicedesk>/api-key
SERVICE_DESK_RATE_LIMIT_URL=https://<your-servicedesk>/rate-limit

# Local text-to-speech settings
LOCAL_TTS_ENDPOINT=https://your-tts-endpoint/v1
LOCAL_TTS_MODEL=tts-1-hd
LOCAL_TTS_VOICE=tr-male-1
# Set to FALSE to skip SSL verification for self-signed certs (on-prem only)
LOCAL_TTS_VERIFY_SSL=TRUE

LOCAL_STT_ENDPOINT=http://localhost:8080/v1/audio/transcriptions
LOCAL_STT_MODEL=whisper-large-v3

# Optional: override the TTS API key. If left blank, the encrypted primary API key
# you already store for the main models will be reused automatically.
LOCAL_TTS_API_KEY=
LOCAL_STT_API_KEY=

# Filtreleme için kullanılacak model (varsa özel bir model, yoksa primary kullanılır)
FILTER_MODEL=technical name 1

# ------------------------------------------------------------------------------
# GÖRSEL OLUŞTURMA AYARLARI (IMAGE GENERATION)
# ------------------------------------------------------------------------------

# DALL-E-3 API Endpoint URL
IMAGE_GEN_ENDPOINT=https://your-image-api-endpoint.com/v1/images/generations

# Görsel oluşturma modeli
IMAGE_GEN_MODEL=dall-e-3

# Türkçe → İngilizce çeviri modeli (prompt çevirisi için)
TRANSLATION_MODEL=technical name 1

# Görsel oluşturma zaman aşımı (saniye) - HD görseller için uzun süre gerekli
IMAGE_GEN_TIMEOUT=180

# ------------------------------------------------------------------------------
# AI UZMAN (AI EXPERT) KONUSMA AYARLARI
# ------------------------------------------------------------------------------

# AI Uzman konusma metni olusturmak icin kullanilacak model
# Butunlesik modda proaktif konusma icin (karsilama, sayfa rehberligi vb.)
AI_EXPERT_MODEL=technical name 1

# ------------------------------------------------------------------------------
# DESTEK CHATBOT AYARLARI
# ------------------------------------------------------------------------------

# Yardim Merkezi chatbot asistani icin kullanilacak model
# Tanimli degilse AI_EXPERT_MODEL veya FILTER_MODEL kullanilir
DESTEK_CHATBOT_MODEL=technical name 1