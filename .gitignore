# History files
.Rhistory
.Rapp.history

# Session Data
.RData
.Ruserdata

# User-specific files
.Rproj.user/

# Secrets and environment variables
.Renviron
.Renviron.local

# R-Studio files
.rstudio-desktop

# Shiny-specific files
rsconnect/
manifest.json
shiny_cache/

# Package management directories
# renv: kilit dosyası (renv.lock), renv/activate.R, renv/settings.json ve
# renv/.gitignore COMMIT EDİLİR; yerel paket kütüphanesi / önbellek / staging
# COMMIT EDİLMEZ (aşağıdaki alt yollar yok sayılır).
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
packrat/

# Log files
*.log
*.log.*

# macOS specific files
.DS_Store
.AppleDouble
.LSOverride

# Thumbs.db and Desktop.ini files (Windows)
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# R temporary files
*.utf8.md
*.knit.md
artifacts/ai-validation/
artifacts/seam-doctor/
artifacts/frontend-complexity-doctor/
artifacts/validation-doctor/
artifacts/vm-evidence/
artifacts/soak/
artifacts/sqlserver-pool-preflight/
artifacts/browser-concurrency/
.ai/proposed_answer.md
.ai/*.tmp.md
.ai/*.log
!.ai/.gitkeep

# Bilge Yolaç indirme klasörü çalışma zamanında doldurulur (kullanıcı/oturum
# alt klasörleri). Yalnızca dizini koru; üretilen dosyaları izleme.
bilge_yolac_downloads/*
!bilge_yolac_downloads/.gitkeep

# testthat failing-test debris (local diagnostic runs)
tests/testthat/_problems/
tests/testthat/testthat-problems.rds

# VoxCPM2 ses profili şablonu: gerçek biyometrik kayıtlar / gerçek manifest /
# gerçek transcript ASLA commit edilmez. Yalnızca .gitkeep, README ve *.example
# dosyaları izlenir. Gerçek dağıtım verisi depo dışında (ör. C:/MERGEN_Bilge_Data)
# tutulur.
deployment/tts_voices_template/**/*.wav
deployment/tts_voices_template/manifest.json
deployment/tts_voices_template/reference_transcript_tr_v1.txt
